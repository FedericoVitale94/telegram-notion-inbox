# Telegram: token from @BotFather, your user ID from @userinfobot (several IDs separated by commas)
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_USER_IDS=

# Notion: internal integration (notion.so/profile/integrations), shared with the page that holds INBOX
NOTION_TOKEN=
# Printed by setup_notion.py
NOTION_INBOX_DB_ID=

# LLM: anthropic (default) or groq
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL_CLASSIFY=claude-haiku-5-5
ANTHROPIC_MODEL_DRAFT=claude-opus-5-5
ANTHROPIC_MODEL_AGENT=claude-sonnet-5-5

# Groq: Whisper transcription (free tier) and optional alternative LLM
GROQ_API_KEY=
GROQ_LLM_MODEL=llama-3.3-70b-versatile
